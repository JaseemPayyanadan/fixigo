rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userShopId() {
      return userDoc().shopId;
    }

    function userRole() {
      return userDoc().role;
    }

    function userBranchId() {
      return userDoc().branchId;
    }

    function sameShop(shopId) {
      return signedIn()
        && shopId is string
        && shopId.size() > 0
        && userShopId() == shopId;
    }

    function isShopAdmin() {
      return signedIn() && userRole() == 'shop_admin';
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSelf(userId)
        || (signedIn() && resource.data.keys().hasAny(['shopId']) && resource.data.shopId == userShopId());
      allow create: if false;
      allow update: if isSelf(userId)
        || (isShopAdmin() && resource.data.shopId == userShopId());
      allow delete: if false;
    }

    match /shops/{shopId} {
      allow read: if signedIn() && shopId == userShopId();
      allow write: if false;
      allow delete: if false;

      match /branches/{branchId} {
        allow read: if sameShop(shopId);
        allow write: if false;

        match /technicians/{technicianId} {
          allow read: if sameShop(shopId);
          allow write: if false;
        }
      }
    }

    match /branches/{branchId} {
      allow read: if sameShop(resource.data.shopId);
      allow create: if sameShop(request.resource.data.shopId) && isShopAdmin();
      allow update: if sameShop(resource.data.shopId)
        && (isShopAdmin() || (userRole() == 'branch_admin' && userBranchId() == branchId));
      allow delete: if false;
    }

    match /technicians/{technicianId} {
      allow read: if sameShop(resource.data.shopId);
      allow create: if sameShop(request.resource.data.shopId)
        && (isShopAdmin() || userRole() == 'branch_admin');
      allow update: if sameShop(resource.data.shopId)
        && (isShopAdmin()
          || (userRole() == 'branch_admin' && userBranchId() == resource.data.branchId)
          || request.auth.uid == resource.data.userId);
      allow delete: if false;
    }

    match /services/{serviceId} {
      allow read: if sameShop(resource.data.shopId);
      allow create: if sameShop(request.resource.data.shopId);
      allow update: if sameShop(resource.data.shopId);
      allow delete: if sameShop(resource.data.shopId) && isShopAdmin();
    }

    match /customers/{customerId} {
      allow read: if sameShop(resource.data.shopId);
      allow create: if sameShop(request.resource.data.shopId);
      allow update: if sameShop(resource.data.shopId);
      allow delete: if false;
    }

    match /parts/{partId} {
      allow read: if sameShop(resource.data.shopId);
      allow create: if sameShop(request.resource.data.shopId);
      allow update: if sameShop(resource.data.shopId);
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isSelf(resource.data.userId);
      allow create: if isSelf(request.resource.data.userId);
    }

    match /audit_logs/{logId} {
      allow read: if sameShop(resource.data.shopId);
      allow write, delete: if false;
    }

    match /suppliers/{supplierId} {
      allow read: if sameShop(resource.data.shopId);
      allow write: if false;
    }

    match /purchases/{purchaseId} {
      allow read: if sameShop(resource.data.shopId);
      allow write: if false;
    }

    match /purchaseCounters/{shopId} {
      allow read, write: if false;
    }
  }
}
